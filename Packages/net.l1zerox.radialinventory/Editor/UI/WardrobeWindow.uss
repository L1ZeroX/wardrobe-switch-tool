.wardrobe-root { flex-grow: 1; padding: 8px; font-size: 13px; }
.toolbar { flex-direction: row; align-items: center; flex-shrink: 0; margin-bottom: 5px; flex-wrap: wrap; }
.title { font-size: 18px; -unity-font-style: bold; margin-right: 12px; }
.badge { border-radius: 4px; padding: 4px 8px; background-color: rgb(52, 81, 107); color: rgb(235, 246, 255); }
.grow, .spacer { flex-grow: 1; min-height: 0; }
.columns { flex-direction: row; }
.column { padding: 6px; margin-right: 5px; border-width: 1px; border-color: rgba(128,128,128,0.4); border-radius: 4px; min-width: 0; }
.groups { width: 24%; }
.props { width: 38%; }
.details { flex-grow: 1; width: 38%; margin-right: 0; }
.section { font-size: 14px; -unity-font-style: bold; margin-bottom: 7px; }
Button { min-height: 28px; padding-left: 9px; padding-right: 9px; font-size: 13px; }
Button:focus { border-color: rgb(56, 157, 246); border-width: 2px; }
#prop-search Button { min-height: 16px; height: 16px; width: 16px; padding: 0; }
.primary { background-color: rgb(35, 102, 154); color: white; min-width: 170px; min-height: 34px; }
.selected-mode { border-bottom-width: 3px; border-bottom-color: rgb(44, 161, 255); -unity-font-style: bold; }
.unity-base-field { margin-bottom: 5px; min-height: 24px; }
.unity-base-field__label, .unity-base-field__input { font-size: 13px; }
.unity-base-field__label { min-width: 120px; }
.group-list { height: 190px; min-height: 100px; flex-shrink: 0; }
.prop-list { min-height: 120px; }
.group-settings { max-height: 290px; flex-shrink: 1; }
.list-row { flex-direction: row; align-items: center; padding: 3px 6px; height: 42px; }
.list-row Image { width: 34px; height: 34px; margin-right: 8px; }
.list-row Label { flex-grow: 1; overflow: hidden; -unity-text-overflow-position: end; text-overflow: ellipsis; }
.unity-collection-view__item--selected { background-color: rgba(29,122,194,0.45); border-bottom-color: rgb(44,161,255); border-bottom-width: 2px; }
.hint { white-space: normal; font-size: 12px; margin-top: 4px; margin-bottom: 4px; }
.diagnostics { max-height: 100px; flex-shrink: 1; }
.actions { margin-top: 6px; }
.credit { flex-direction: row; align-items: center; flex-shrink: 0; height: 58px; }
.credit Image { width: 48px; height: 54px; margin-right: 10px; }
.credit Label { margin-right: 20px; }
.light .badge { background-color: rgb(215,233,250); color: rgb(30,55,75); }
