<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
  <ui:VisualElement name="wardrobe-root" class="wardrobe-root">
    <ui:VisualElement class="toolbar header">
      <ui:VisualElement name="brand-icon" class="brand-icon" />
      <ui:Label name="title" class="title" text="衣装簡単切替ツール" />
      <ui:VisualElement class="spacer" /><ui:Label name="version" class="badge" />
    </ui:VisualElement>
    <ui:VisualElement class="tabs">
      <ui:Button name="group-menu" tooltip="グループを選択するメニューを開きます" class="tab"><ui:VisualElement name="group-tab-icon" class="tab-icon" /><ui:Label text="グループ ▾" /></ui:Button>
      <ui:Button name="wardrobe-tab" class="tab"><ui:VisualElement name="wardrobe-tab-icon" class="tab-icon" /><ui:Label text="衣装管理" /></ui:Button>
      <ui:Button name="details-tab" class="tab"><ui:VisualElement name="details-tab-icon" class="tab-icon" /><ui:Label text="詳細設定" /></ui:Button>
    </ui:VisualElement>
    <ui:VisualElement name="native-editor" class="grow">
      <ui:VisualElement name="workspace" class="columns grow">
        <ui:VisualElement class="panel groups">
          <ui:Label text="衣装グループ" class="section" /><ui:ListView name="groups" class="group-list" />
          <ui:Label name="empty-groups" text="上の「グループ」から追加できます" class="hint" />
          <ui:ScrollView name="group-picture" class="grow group-preview" />
        </ui:VisualElement>
        <ui:VisualElement class="panel clothes grow">
          <ui:VisualElement name="clothes-page" class="grow">
            <ui:Label text="衣装一覧" class="section" />
            <ui:VisualElement name="basic-editor" class="grow">
              <uie:ToolbarSearchField name="prop-search" /><ui:ListView name="props" class="grow prop-list" />
              <ui:Button name="add-prop" text="＋　衣装を追加" class="outline" />
              <ui:VisualElement class="toolbar small-actions"><ui:Button name="prop-up" text="↑" tooltip="衣装を上へ" /><ui:Button name="prop-down" text="↓" tooltip="衣装を下へ" /><ui:VisualElement class="spacer" /><ui:Button name="remove-prop" text="削除" /></ui:VisualElement>
              <ui:Foldout name="prop-foldout" text="選択した衣装の設定" value="false" class="prop-foldout"><ui:ScrollView name="prop-details" class="prop-details" /></ui:Foldout>
            </ui:VisualElement>
            <ui:ScrollView name="compatible-tab" class="grow" />
          </ui:VisualElement>
          <ui:ScrollView name="settings-page" class="grow">
            <ui:Label text="詳細設定" class="section" /><ui:Label text="対象アバター" class="subsection" />
            <uie:ObjectField name="avatar" />
            <ui:VisualElement class="toolbar"><ui:Button name="use-selection" text="選択中を使う" /><ui:Button name="export" text="設定を保存…" /><ui:Button name="import" text="設定を読込…" /></ui:VisualElement>
            <ui:VisualElement name="global-settings" />
            <ui:Label text="グループの編集" class="subsection" />
            <ui:VisualElement class="toolbar"><ui:Button name="add-group" text="＋ 追加" /><ui:Button name="group-up" text="↑" /><ui:Button name="group-down" text="↓" /><ui:Button name="remove-group" text="削除" /></ui:VisualElement>
            <ui:ScrollView name="group-settings" />
            <ui:Label text="補正・ツール" class="subsection" /><ui:Button name="helpers" text="画像・補助ツール" /><ui:Button name="chest" text="胸・衣装補正" />
            <ui:Label text="表示・編集モード" class="subsection" /><ui:VisualElement name="modes" class="toolbar" /><ui:Button name="settings" text="表示するモードを設定…" />
          </ui:ScrollView>
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:ProgressBar name="capacity" title="パラメーター容量" low-value="0" high-value="256" /><ui:ScrollView name="diagnostics" class="diagnostics" /><ui:Label name="status" class="hint" />
      <ui:Button name="apply" text="✓　変更を適用する" class="primary" />
      <ui:VisualElement class="toolbar footer-actions"><ui:Label text="衣装をグループへドラッグして登録" class="hint grow" /><ui:Button name="detach" text="適用を解除" /></ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="legacy-host" class="grow" />
    <ui:VisualElement class="toolbar footer"><ui:VisualElement name="credit" class="credit grow" /><ui:Button name="legacy" text="互換画面" tooltip="同じ設定のまま従来の編集画面へ切り替えます" /></ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
