<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
  <ui:VisualElement name="wardrobe-root" class="wardrobe-root">
    <ui:VisualElement class="toolbar">
      <ui:Label name="title" class="title" text="衣装簡単切替ツール" />
      <ui:Label text="UI Toolkit ベータ" class="badge" />
      <ui:VisualElement class="spacer" />
      <ui:Button name="settings" text="表示設定" />
      <ui:Button name="helpers" text="補助ツール" />
      <ui:Button name="chest" text="胸・衣装補正" />
      <ui:Button name="legacy" text="互換画面" tooltip="同じ設定のまま従来の編集画面へ切り替えます。" />
    </ui:VisualElement>
    <ui:VisualElement name="native-editor" class="grow">
      <ui:VisualElement class="toolbar">
        <uie:ObjectField name="avatar" label="対象アバター" class="grow" />
        <ui:Button name="use-selection" text="選択中を使う" />
        <ui:Button name="export" text="設定を保存…" />
        <ui:Button name="import" text="設定を読込…" />
      </ui:VisualElement>
      <ui:VisualElement name="global-settings" />
      <ui:VisualElement name="modes" class="toolbar" />
      <ui:VisualElement name="basic-editor" class="columns grow">
        <ui:VisualElement class="column groups">
          <ui:Label text="① グループ" class="section" />
          <ui:VisualElement class="toolbar">
            <ui:Button name="add-group" text="＋ 追加" />
            <ui:Button name="remove-group" text="削除" />
            <ui:Button name="group-up" text="↑" tooltip="グループを上へ" />
            <ui:Button name="group-down" text="↓" tooltip="グループを下へ" />
          </ui:VisualElement>
          <ui:ListView name="groups" class="group-list" />
          <ui:ScrollView name="group-picture" class="grow" />
        </ui:VisualElement>
        <ui:VisualElement class="column props">
          <ui:Label text="② グループ設定・衣装" class="section" />
          <ui:ScrollView name="group-settings" class="group-settings" />
          <uie:ToolbarSearchField name="prop-search" />
          <ui:VisualElement class="toolbar">
            <ui:Button name="add-prop" text="＋ 追加" />
            <ui:Button name="remove-prop" text="削除" />
            <ui:Button name="prop-up" text="↑" tooltip="プロップを上へ" />
            <ui:Button name="prop-down" text="↓" tooltip="プロップを下へ" />
          </ui:VisualElement>
          <ui:ListView name="props" class="grow prop-list" />
          <ui:Label text="衣装をグループ行へドラッグして登録" class="hint" />
        </ui:VisualElement>
        <ui:VisualElement class="column details">
          <ui:Label text="③ 衣装の詳細" class="section" />
          <ui:ScrollView name="prop-details" class="grow" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:ScrollView name="compatible-tab" class="grow" />
      <ui:ProgressBar name="capacity" title="パラメーター容量" low-value="0" high-value="256" />
      <ui:ScrollView name="diagnostics" class="diagnostics" />
      <ui:VisualElement class="toolbar actions">
        <ui:Label name="status" class="grow hint" />
        <ui:Button name="detach" text="適用を解除" />
        <ui:Button name="apply" text="アバターへ適用する" class="primary" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="legacy-host" class="grow" />
    <ui:VisualElement name="credit" class="credit" />
  </ui:VisualElement>
</ui:UXML>
