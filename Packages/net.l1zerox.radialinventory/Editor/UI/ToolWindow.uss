.wardrobe-root { flex-grow: 1; background-color: rgb(20,21,25); color: rgb(242,243,247); font-size: 14px; padding: 12px 22px 10px; }
.toolbar { flex-direction: row; align-items: center; flex-shrink: 0; flex-wrap: wrap; margin-bottom: 8px; }
.grow, .spacer { flex-grow: 1; min-height: 0; }
.app-bar { margin-bottom: 0; }
.app-title { font-size: 12px; color: rgb(165,172,185); }
.badge { font-size: 10px; border-radius: 8px; padding: 3px 8px; margin-left: 8px; background-color: rgb(35,54,85); color: rgb(143,187,255); }
.hero { padding: 12px 6px 18px; flex-shrink: 0; }
.hero-title { font-size: 30px; -unity-font-style: bold; margin-bottom: 5px; white-space: normal; }
.subtitle, .eyebrow { color: rgb(164,172,190); font-size: 13px; white-space: normal; }
.hero .toolbar { margin-bottom: 4px; }
.page { padding: 0 4px; }
.card { background-color: rgb(34,36,43); border-radius: 22px; padding: 18px; margin-bottom: 12px; flex-shrink: 0; }
.compact { padding: 10px 16px; }
.details-card { flex-shrink: 1; }
.section { font-size: 16px; -unity-font-style: bold; margin-bottom: 10px; }
.section-bar .section { margin-bottom: 0; }
Button { min-height: 36px; border-radius: 18px; background-color: rgb(49,52,62); border-width: 0; color: rgb(236,239,246); padding: 5px 16px; margin: 3px; font-size: 13px; }
Button:hover { background-color: rgb(65,71,86); }
Button:focus { border-color: rgb(134,186,255); border-width: 2px; }
Button:disabled { opacity: 0.45; }
.quiet { background-color: rgba(0,0,0,0); color: rgb(175,190,215); }
.accent, .tool-button { color: rgb(163,197,255); background-color: rgb(37,52,76); }
.primary { background-color: rgb(66,125,244); color: white; min-width: 190px; min-height: 42px; -unity-font-style: bold; }
.primary:hover { background-color: rgb(88,145,255); }
.avatar-chip { -unity-text-align: middle-left; border-radius: 16px; background-color: rgb(34,36,43); margin-bottom: 10px; }
.card-list { min-height: 80px; }
.list-row { flex-direction: row; align-items: center; padding: 8px 16px; margin: 5px 4px; height: 94px; border-radius: 22px; background-color: rgb(34,36,43); }
.list-row Image { width: 74px; height: 74px; margin-right: 18px; background-color: rgb(28,30,36); border-radius: 16px; }
.row-copy { flex-grow: 1; }
.row-name { font-size: 17px; -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; }
.row-description { font-size: 12px; color: rgb(163,172,190); margin-top: 6px; }
.unity-collection-view__item--selected { background-color: rgba(0,0,0,0); }
.unity-collection-view__item--selected .list-row { background-color: rgb(34,60,96); border-color: rgb(100,161,255); border-width: 1px; }
.hint { white-space: normal; font-size: 12px; color: rgb(170,178,194); margin: 6px 0; }
.empty-state { white-space: normal; padding: 22px; color: rgb(170,178,194); }
.unity-base-field { min-height: 32px; margin: 6px 0; }
.unity-base-field__label { min-width: 190px; font-size: 14px; color: rgb(226,231,240); }
.unity-base-field__input { font-size: 14px; border-radius: 8px; }
.unity-base-text-field__input { padding: 5px 9px; }
.unity-toggle__input { background-color: rgba(0,0,0,0); }
.unity-foldout__toggle { margin-bottom: 7px; }
#prop-search { margin: 4px 2px 10px; min-height: 34px; }
#prop-search Button { min-height: 16px; height: 16px; width: 16px; padding: 0; margin: 0; }
#global-settings .toolbar { flex-direction: column; align-items: stretch; }
#global-settings .unity-base-field { width: auto; }
#registration-tools { margin-top: 8px; }
.bottom-dock { padding-top: 10px; flex-shrink: 0; }
.diagnostics { max-height: 74px; }
.actions { margin: 4px 0; }
.bottom-nav { margin: 0; background-color: rgb(30,32,39); border-radius: 22px; padding: 4px; }
.bottom-nav Button { flex-grow: 1; flex-basis: 0; background-color: rgba(0,0,0,0); min-height: 38px; }
.bottom-nav .nav-selected, .selected-mode { background-color: rgb(44,65,99); color: rgb(179,209,255); -unity-font-style: bold; }
.credit { flex-direction: row; align-items: center; min-height: 64px; }
.credit Image { width: 48px; height: 54px; margin-right: 12px; }
.credit Label { margin-right: 14px; }
#capacity { height: 18px; }
#capacity .unity-progress-bar__background { background-color: rgb(39,43,53); border-radius: 8px; }
#capacity .unity-progress-bar__progress { background-color: rgb(71,129,241); border-radius: 8px; }
#prop-details .unity-scroll-view__content-container { padding-right: 8px; }
#group-picture Image, #prop-image { margin-bottom: 12px; background-color: rgb(27,29,35); border-radius: 20px; }
.light.wardrobe-root { background-color: rgb(242,244,248); color: rgb(27,31,40); }
.light .card, .light .list-row, .light .avatar-chip { background-color: white; }
.light Button { background-color: rgb(229,234,244); color: rgb(40,63,100); }
.light .primary { background-color: rgb(45,105,224); color: white; }
.light .subtitle, .light .hint, .light .eyebrow, .light .row-description, .light .app-title { color: rgb(85,98,120); }
.light .unity-base-field__label { color: rgb(34,43,59); }
.light .unity-collection-view__item--selected .list-row { background-color: rgb(221,234,255); }
.light .bottom-nav { background-color: rgb(225,230,240); }
.light .bottom-nav .nav-selected { background-color: white; color: rgb(38,91,185); }
.light #group-picture Image, .light #prop-image, .light .list-row Image { background-color: rgb(235,239,246); }
.narrow .hero-title { font-size: 24px; }
.narrow .hero { padding-bottom: 10px; }
.narrow .unity-base-field__label { min-width: 150px; }

.one-switch .unity-base-field__label { flex-grow: 1; }
.one-switch .unity-base-field__input { flex-grow: 0; }
.one-switch .unity-toggle__checkmark { display: none; }
.switch-track { width: 42px; height: 24px; border-radius: 12px; background-color: rgb(88,96,112); padding: 3px; justify-content: center; align-items: flex-start; }
.switch-knob { width: 18px; height: 18px; border-radius: 9px; background-color: rgb(235,240,249); }
.switch-on .switch-track { background-color: rgb(66,125,244); align-items: flex-end; }
.one-switch:focus .switch-track { border-width: 1px; border-color: rgb(168,204,255); }
#prop-search { width: auto; max-width: none; }
